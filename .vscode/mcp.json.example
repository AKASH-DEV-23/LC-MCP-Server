{
  "servers": {
    "leetcode-sync": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/dist/server.js"],
      "env": {
        "GITHUB_TOKEN": "${input:githubToken}",
        "GITHUB_REPO": "owner/repository",
        "LEETCODE_CSRF_TOKEN": "${input:leetcodeCsrf}",
        "LEETCODE_SESSION": "${input:leetcodeSession}",
        "DESTINATION_FOLDER": "DSA"
      }
    }
  },
  "inputs": [
    {"id":"githubToken","type":"promptString","description":"GitHub token","password":true},
    {"id":"leetcodeCsrf","type":"promptString","description":"LeetCode CSRF token","password":true},
    {"id":"leetcodeSession","type":"promptString","description":"LeetCode session","password":true}
  ]
}
